[Unit]
# Second bot, beside claudecoach-bot.service, not replacing it. Own token, own
# process, own log. Install with:
# NOTE the paths: the VM MIRRORS the Mac's home path, so the live repo is at
# /Users/diamondpeakconsulting/diamondpeak-site even on Linux. /root/diamondpeak-site
# does not exist. Confirm with:
#   systemctl show -p WorkingDirectory claudecoach-bot
#   cp ClaudeCoach/telegram/claudecoach-nutrition.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now claudecoach-nutrition
Description=ClaudeCoach nutrition logger (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/Users/diamondpeakconsulting/diamondpeak-site
ExecStart=/usr/bin/python3 /Users/diamondpeakconsulting/diamondpeak-site/ClaudeCoach/telegram/nutrition_bot.py
# The ladder's LLM rung and the whole NLU layer shell out to the claude CLI, which needs
# the same auth the coach bot uses. The path is /root/.CLAUDE/cc.env, NOT /root/cc.env:
# an earlier version of this unit had the latter with a leading '-', so the missing file
# was ignored silently and every model call failed 401 while the bot looked healthy.
# Confirm against the live coach rather than guessing:
#   systemctl show -p EnvironmentFiles claudecoach-bot
EnvironmentFile=/root/.claude/cc.env
Environment=HOME=/root
Environment=CLAUDE_BIN=/usr/bin/claude
Restart=always
RestartSec=10
# A crash loop must not spin: five restarts in a minute and it stays down so the
# failure is visible rather than hidden behind a bot that appears to be running.
StartLimitBurst=5
StartLimitIntervalSec=60
StandardOutput=append:/Users/diamondpeakconsulting/diamondpeak-site/ClaudeCoach/telegram/nutrition_bot.log
StandardError=append:/Users/diamondpeakconsulting/diamondpeak-site/ClaudeCoach/telegram/nutrition_bot.log

[Install]
WantedBy=multi-user.target
